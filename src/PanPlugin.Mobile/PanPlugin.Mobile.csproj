<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PanPlugin.Mobile</RootNamespace>
    <AssemblyName>PanPlugin.Mobile</AssemblyName>
    <!-- Android 包名：M1 内测用调试签名，正式发布时再配发布 keystore -->
    <ApplicationId>com.wuhou.panplugin.mobile</ApplicationId>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- .NET 10 模板默认 API 24，避免 Java 默认接口方法的 desugaring 崩溃 -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- .NET 10 默认 targetSdk 36（Android 16），旧系统与部分国产 ROM 会「解析软件包时出现问题」。
         降到 34（Android 14）：内测分发不需要追新 API，覆盖面更广。 -->
    <TargetSdkVersion>34</TargetSdkVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" />
  </ItemGroup>

  <!-- M2：链接桌面端已拆出的纯业务源码，规则只有一份；WinForms 弹窗不链接。 -->
  <ItemGroup>
    <Compile Include="../PanPlugin/Model.cs" Link="Shared/Model.cs" />
    <Compile Include="../PanPlugin/Period.cs" Link="Shared/Period.cs" />
    <Compile Include="../PanPlugin/Parsers.cs" Link="Shared/Parsers.cs" />
    <Compile Include="../PanPlugin/Store.cs" Link="Shared/Store.cs" />
    <Compile Include="../PanPlugin/ImportService.cs" Link="Shared/ImportService.cs" />
    <Compile Include="../PanPlugin/CustomerService.cs" Link="Shared/CustomerService.cs" />
    <Compile Include="../PanPlugin/MaintenanceService.cs" Link="Shared/MaintenanceService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
