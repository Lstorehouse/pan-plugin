<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PanPlugin.Mobile</RootNamespace>
    <AssemblyName>PanPlugin.Mobile</AssemblyName>
    <!-- Android 包名：M1 内测用调试签名，正式发布时再配发布 keystore -->
    <ApplicationId>com.wuhou.panplugin.mobile</ApplicationId>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Android 5.0 (API 21) 起支持，覆盖绝大多数在用设备 -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" />
  </ItemGroup>

  <!--
    M2 起在这里链接桌面版业务源码，保证规则只有一份：
    <Compile Include="../PanPlugin/Model.cs" Link="Shared/Model.cs" />
    <Compile Include="../PanPlugin/Store.cs" Link="Shared/Store.cs" />
    <Compile Include="../PanPlugin/Parsers.cs" Link="Shared/Parsers.cs" />
    注意 Period.cs 顶部含 System.Windows.Forms 的导入弹窗，M2 需先拆分纯逻辑与窗体。
    M1 只交付可安装、可切换四个 Tab 的骨架，不引入业务代码与任何真实数据。
  -->

</Project>
