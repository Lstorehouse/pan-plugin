<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PanPlugin.Mobile.Views"
       x:Class="PanPlugin.Mobile.AppShell"
       Shell.BackgroundColor="{StaticResource PrimaryColor}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="{StaticResource PrimaryColor}"
       Shell.TabBarUnselectedColor="{StaticResource TextSecondaryColor}">

    <TabBar>
        <ShellContent Title="首页"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="客户"
                      ContentTemplate="{DataTemplate views:CustomerPage}" />
        <ShellContent Title="导入"
                      ContentTemplate="{DataTemplate views:ImportPage}" />
        <ShellContent Title="我的"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
