<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PanPlugin.Mobile.Views.CustomerPage"
             Title="客户"
             BackgroundColor="{StaticResource PageColor}">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="客户" FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimaryColor}" />
        <SearchBar x:Name="SearchBar" Placeholder="输入客户名或别名…"
                   BackgroundColor="White" TextChanged="OnSearchChanged" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label x:Name="SummaryLabel" Text="本地账本"
                   FontSize="13" TextColor="{StaticResource TextSecondaryColor}"
                   VerticalOptions="Center" />
            <Button x:Name="ArchivedButton" Grid.Column="1" Text="显示已归档"
                    FontSize="12" Padding="10,6" BackgroundColor="White"
                    TextColor="{StaticResource PrimaryColor}"
                    BorderColor="#B5D4F4" Clicked="OnToggleArchived" />
        </Grid>
        <CollectionView x:Name="CustomerList" SelectionMode="Single"
                        SelectionChanged="OnCustomerSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="14" Margin="0,0,0,8" BackgroundColor="White"
                           BorderColor="#D8DEE6">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}" />
                            <Label Text="{Binding Detail}" FontSize="12"
                                   TextColor="{StaticResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="没有匹配的客户。导入名单或手工新建后会出现在这里。"
                       Padding="16" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextSecondaryColor}" />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
