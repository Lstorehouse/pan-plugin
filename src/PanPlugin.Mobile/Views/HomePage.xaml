<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PanPlugin.Mobile.Views.HomePage"
             Title="首页"
             BackgroundColor="{StaticResource PageColor}">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="生化盘客户管理"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimaryColor}" />
        <Label Text="M1 骨架：搜索与列表将在 M3 接入"
               FontSize="13" TextColor="{StaticResource TextSecondaryColor}" />
        <SearchBar Placeholder="输入客户名或别名…"
                   BackgroundColor="White" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Frame Grid.Column="0" Padding="14" BackgroundColor="White" BorderColor="#D8DEE6">
                <VerticalStackLayout Spacing="4">
                    <Label Text="待补盘" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="— 张" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource DangerColor}" />
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Column="1" Padding="14" BackgroundColor="White" BorderColor="#D8DEE6">
                <VerticalStackLayout Spacing="4">
                    <Label Text="抵扣余额" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="¥—" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <Label Text="筛选胶囊与待补优先排序将在这里出现。"
               FontSize="13" TextColor="{StaticResource TextSecondaryColor}" />
    </VerticalStackLayout>
</ContentPage>
